{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --root .. tests/integration.test.ts tests/sentinels.test.ts tests/simulation.test.ts tests/world.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src ../tests",
    "format": "prettier --write src ../tests index.html",
    "check": "npm run lint && npm run test && npm run build",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
